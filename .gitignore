# 构建产物
build/
cmake-build-*/
*.o
*.a
*.so
*.dylib

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 缓存
.cache/
.ccache/
CMakeCache.txt
CMakeFiles/

# 日志与运行时输出
logs/
# 任务档案的默认位置：outputs.dir 没写时是 runs/<任务名>
runs/
# 个人的任务文件（本机的数据集路径等），不入库；只留说明
configs/local/*
!configs/local/README.md

# 内部文档（设计、调研等，不对外发布）
docs/
# 只服务内部文档的检查工具，跟着文档留在本地
/.githooks/
/scripts/doc_lint.py

# Docker 构建连不上 GitHub 时用的 manif 本地副本（见 Dockerfile 开头的说明）
docker/deps/

# 临时文件
*.zip

# 本地文档/配置（本地保留，不入库）
/AGENTS.md
/Claude_Code_工具链配置文档.md

# 系统文件
.DS_Store
Thumbs.db

# 代理会话数据
.claude/
.codex/
.agents/
.kimi-code/

# Python 字节码（scripts/ 与 python/ 下都会产生）
__pycache__/
*.py[cod]
